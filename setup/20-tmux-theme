#!/bin/bash
# Re-theme running tmux servers after an Omarchy theme switch.
# Re-sources the main tmux config, which runs tpm (tmux-gruvbox) and then
# sources the theme's tmux.conf if it ships one (e.g. hexafunk), followed by
# anything after it (such as format patches). Themes without a tmux.conf
# fall back to the tmux-gruvbox status bar.

tmux list-sessions >/dev/null 2>&1 || exit 0

for conf in "$HOME/.tmux.conf" "$HOME/.config/tmux/tmux.conf"; do
  if [[ -f $conf ]]; then
    tmux source-file "$conf"
    exit 0
  fi
done
